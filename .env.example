# Copy to api/.env for local dev, or set these as real environment variables in prod.
# Every key is prefixed NEXUS_CARD_ (see api/src/nexus_card/config.py).

NEXUS_CARD_ENV=dev
NEXUS_CARD_LOG_LEVEL=INFO

# Used for canonical + Open Graph URLs stamped into the served HTML.
NEXUS_CARD_PUBLIC_BASE_URL=https://card.noahnexus.ai
NEXUS_CARD_CORS_ORIGINS=["http://localhost:5173"]

# Card shown at / when the path carries no slug.
NEXUS_CARD_DEFAULT_CARD_SLUG=grantpan

# --- LLM ---------------------------------------------------------------------
# bedrock  = AWS Bedrock ConverseStream (same region/account as the AgentCore runtime)
# anthropic = Anthropic Messages API (local dev without AWS)
# echo      = deterministic, no network — for tests and offline demos
NEXUS_CARD_LLM_PROVIDER=bedrock
NEXUS_CARD_AWS_REGION=ap-southeast-1
NEXUS_CARD_BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-5-20250929-v1:0
NEXUS_CARD_BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# NEXUS_CARD_ANTHROPIC_API_KEY=sk-ant-...
# NEXUS_CARD_ANTHROPIC_MODEL_ID=claude-sonnet-4-5

NEXUS_CARD_LLM_MAX_TOKENS=700
NEXUS_CARD_LLM_TEMPERATURE=0.2

# --- retrieval ---------------------------------------------------------------
# Set to false to force BM25-only (no Bedrock embedding calls at query time).
NEXUS_CARD_EMBEDDINGS_ENABLED=true
NEXUS_CARD_RETRIEVAL_TOP_K=5

# --- abuse control -----------------------------------------------------------
NEXUS_CARD_RATE_LIMIT_PER_MIN=12
NEXUS_CARD_RATE_LIMIT_BURST=4
NEXUS_CARD_MAX_QUESTION_CHARS=600
